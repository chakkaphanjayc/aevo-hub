{
  "name": "aevo-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/dev.ts",
    "dev:all": "bun run scripts/dev.ts",
    "dev:modern": "bun run --cwd apps/hub dev",
    "dev:modern:tunnel": "AEVO_DEV_TUNNEL=1 bun run --cwd apps/hub dev",
    "dev:admin": "bun run scripts/dev-admin.ts",
    "dev:admin:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/dev-admin.ts",
    "db:migrate": "bun run scripts/migrate-core.ts",
    "db:migrate:core": "bun run scripts/migrate-core.ts",
    "db:migrate:dry-run": "bun run scripts/migrate-core.ts --dry-run",
    "db:migrate:verify": "bun run scripts/migrate-core.ts --verify",
    "auth:migration-check": "bun run scripts/auth-migration-check.ts",
    "auth:legacy-removal-check": "bun run scripts/auth-migration-check.ts --check-legacy-removal",
    "db:seed:tracedee": "bun run scripts/seed-tracedee.ts",
    "admin:add": "bun run scripts/add-admin.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "build": "bun run build:modern && bun run build:admin",
    "build:modern": "bun run --cwd apps/hub build",
    "build:admin": "bun run --cwd apps/admin build"
  },
  "dependencies": {
    "@aevocado/contracts": "file:../aevo-contracts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
