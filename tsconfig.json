{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@aevo/contracts": ["packages/contracts/src/index.ts"],
      "@aevo/query": ["packages/query/src/index.ts"],
      "@aevo/db": ["packages/db/src/index.ts"],
      "@aevo/auth": ["packages/auth/src/index.ts"],
      "@aevo/entitlements": ["packages/entitlements/src/index.ts"],
      "@aevo/ordering": ["packages/ordering/src/index.ts"],
      "@aevo/realtime": ["packages/realtime/src/index.ts"],
      "@aevo/reporting": ["packages/reporting/src/index.ts"],
      "@aevo/push": ["packages/push/src/index.ts"],
      "@aevo/line": ["packages/line/src/index.ts"],
      "@aevo/odoo": ["packages/odoo/src/index.ts"],
      "@aevocado/api-contract": ["packages/api-contract/src/index.ts"],
      "@aevocado/app-access": ["packages/app-access/src/index.ts"],
      "@aevocado/auth-client": ["packages/auth-client/src/index.ts"],
      "@aevocado/design-system": ["packages/design-system/src/index.ts"],
      "@aevocado/observability": ["packages/observability/src/index.ts"],
      "@aevocado/permissions": ["packages/permissions/src/index.ts"],
      "@aevocado/tenant-context": ["packages/tenant-context/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "scripts/**/*",
    "test/**/*"
  ]
}
