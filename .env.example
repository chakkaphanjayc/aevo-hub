NODE_ENV=development
AEVO_ENVIRONMENT=development
AEVO_APP_CODE=HUB
APP_VERSION=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:4330
# Set to 1 to auto-start a Cloudflare Quick Tunnel for the Vite surface.
AEVO_DEV_TUNNEL=0
# Optional stable public hostname used by the local launcher for auth/CORS.
# AEVO_HUB_TUNNEL_URL=https://hub-dev.example.com
# AEVO_ADMIN_TUNNEL_URL=https://admin-dev.example.com
# AEVO_PLAY_TUNNEL_URL=https://play-dev.example.com
# AEVO_POS_TUNNEL_URL=https://pos-dev.example.com
# AEVO_GO_TUNNEL_URL=https://go-dev.example.com
PUBLIC_API_URL=http://localhost:4000
AEVO_API_URL=http://localhost:4000
# Versioned Core API boundary. Local launchers route this through Edge :4000.
AEVO_CORE_API_URL=http://localhost:4000
AEVO_ACCOUNTS_API_ORIGIN=http://localhost:8787
AEVO_ACCOUNTS_SERVICE_SECRET=replace-with-a-development-only-service-secret
AEVO_IDENTITY_PLATFORM_PROJECT_ID=local-development
AEVO_SESSION_SECRET=replace-with-a-development-only-session-secret
AEVO_HUB_WEB_URL=http://localhost:4330
# Optional public landing URL used by authenticated Hub and Workspace Home actions.
# AEVO_HUB_HOME_URL=http://localhost:4321/
AEVO_HUB_OAUTH_CALLBACK_URL=http://localhost:4330/api/auth/oauth/callback
AEVO_PASSWORD_RECOVERY_CALLBACK_URL=http://localhost:4330/api/auth/password/recovery/callback
AEVO_ALLOWED_WEB_ORIGINS=http://localhost:4330,http://localhost:4331,http://localhost:4332,http://localhost:4324
AEVO_PLAY_URL=http://localhost:4331/modern
AEVO_POS_URL=http://localhost:4332
AEVO_GO_URL=http://localhost:4324
# Optional deployment URLs for first-party Kiosk and Queue clients.
# AEVO_KIOSK_URL=http://localhost:4333
# AEVO_QUEUE_URL=http://localhost:4334
AEVO_SSO_EXCHANGE_SECRET=replace-with-a-long-random-secret
# Optional private Accounts broker bridge for Go/other app handoffs.
AEVO_ACCOUNTS_API_ORIGIN=http://localhost:8787
AEVO_ACCOUNTS_EXCHANGE_SECRET=replace-with-the-accounts-service-secret
AEVO_LINE_OAUTH_PROVIDER=custom:line
AEVO_PASSKEY_ENABLED=true

# Direct Supabase PostgreSQL Connection
DATABASE_URL=postgresql://postgres:<password>@<db-host>:5432/postgres?sslmode=require

# Supabase Auth & REST API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<key>
SESSION_COOKIE_NAME=aevo_hub_session
AEVO_GO_SESSION_COOKIE_NAME=aevo_go_session
AEVO_GO_CSRF_COOKIE_NAME=aevo_go_csrf
AEVO_PASSWORD_RECOVERY_COOKIE_NAME=aevo_password_recovery
AEVO_PASSWORD_RECOVERY_GRANT_COOKIE_NAME=aevo_password_recovery_grant
IMPERSONATION_COOKIE_NAME=aevo_impersonation
SESSION_COOKIE_SAME_SITE=lax
# Generate a unique random value with at least 32 characters. Never commit it.
SESSION_COOKIE_SECRET=replace-with-a-long-random-secret
CSRF_COOKIE_NAME=aevo_csrf
SESSION_IDLE_TIMEOUT_SECONDS=2592000
SESSION_ABSOLUTE_TIMEOUT_SECONDS=7776000
# Legacy bootstrap allowlist for /admin; platform_users remains authoritative.
PLATFORM_ADMIN_EMAILS=platform-admin@example.com

# Default Seed / Admin Credentials
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-secure-password
SEED_INITIAL_ROLE=OWNER
LOG_LEVEL=info
# Hub SSR/API request logs: debug, info, warn, or error.
AEVO_HUB_LOG_LEVEL=info
# Mark Hub and Gateway requests as slow when they exceed this duration.
AEVO_HUB_SLOW_REQUEST_MS=750
SLOW_REQUEST_MS=750
